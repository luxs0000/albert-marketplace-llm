# Copy this file to .env (which is never committed) and fill it in.
# Each member uses their own key: it is personal and has a spending limit.

# With an Anthropic key (sk-ant-...), one line:
ANTHROPIC_API_KEY=

# With an OpenRouter key (sk-or-...), delete the line above and use these two instead:
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_AUTH_TOKEN=
